{
  "name": "angular-learning-lab",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content": "node scripts/build-content.mjs",
    "content:watch": "node scripts/build-content.mjs --watch",
    "start": "node scripts/build-content.mjs && ng serve",
    "build": "node scripts/build-content.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/build-content.mjs && ng test",
    "test:content": "node --test \"scripts/**/*.test.mjs\""
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "markdown-it": "15.0.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "yaml": "2.9.1"
  }
}